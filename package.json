{
  "name": "bloctrust-crm",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.26.1 <11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @bloctrust/api --filter @bloctrust/web dev",
    "dev:worker": "pnpm --filter @bloctrust/worker dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && pnpm test:security:unit",
    "test:security:unit": "vitest run tests/security --exclude \"**/*.integration.spec.ts\"",
    "test:security:integration": "vitest run tests/security/tenant-boundary.integration.spec.ts tests/security/session-replay.integration.spec.ts tests/security/crm-core.integration.spec.ts tests/security/invoice-pipeline.integration.spec.ts",
    "test:security:clamav": "vitest run tests/security/clamav.integration.spec.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:foundation": "node scripts/validate-foundation.mjs",
    "validate:milestone": "node scripts/validate-milestone-0.4.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "infra:up": "docker compose up -d --build postgres redis minio clamav mailpit worker",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/common": "11.2.1",
    "@prisma/adapter-pg": "7.9.1",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.1",
    "eslint": "10.8.1",
    "pg": "^8.16.3",
    "prettier": "^3.6.2",
    "prisma": "7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.67.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@prisma/client": "7.9.1"
  }
}
