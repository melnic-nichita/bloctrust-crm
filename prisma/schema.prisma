generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipRole {
  OWNER
  ADMINISTRATOR
  ACCOUNTANT
  RESIDENT
  CONTRACTOR
  AUDITOR
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  ENDED
}

enum PasskeyChallengePurpose {
  REGISTRATION
  STEP_UP
}

enum VendorStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum BankAccountVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum InvoiceStatus {
  PROCESSING
  NEEDS_REVIEW
  MANUAL_REVIEW
  BLOCKED
  AWAITING_APPROVAL
  APPROVED
  REJECTED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  INVALIDATED
}

enum ApprovalDecisionOutcome {
  APPROVE
  REJECT
}

enum DocumentKind {
  INVOICE_SOURCE
}

enum DocumentStorageState {
  QUARANTINED
  APPROVED
  BLOCKED
}

enum DocumentProcessingState {
  QUARANTINED
  SCANNING
  PARSED
  NEEDS_REVIEW
  MANUAL_REVIEW
  BLOCKED
}

enum DocumentScanResult {
  PENDING
  CLEAN
  INFECTED
  ERROR
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique @db.VarChar(320)
  displayName         String               @db.VarChar(120)
  passwordHash        String?              @db.VarChar(512)
  status              UserStatus           @default(ACTIVE)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  memberships         Membership[]
  sessions            Session[]
  webAuthnCredentials WebAuthnCredential[]
  recoveryCodes       RecoveryCode[]
  passkeyChallenges   PasskeyChallenge[]
}

model Organization {
  id                        String                    @id @default(uuid()) @db.Uuid
  slug                      String                    @unique @db.VarChar(80)
  name                      String                    @db.VarChar(160)
  createdAt                 DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                  @updatedAt @db.Timestamptz(3)
  memberships               Membership[]
  invitations               Invitation[]
  sessions                  Session[]
  buildings                 Building[]
  apartments                Apartment[]
  occupancies               Occupancy[]
  vendors                   Vendor[]
  contracts                 Contract[]
  invoices                  Invoice[]
  documents                 Document[]
  auditEvents               AuditEvent[]
  riskPolicy                OrganizationRiskPolicy?
  riskAssessments           RiskAssessment[]
  approvalRequests          ApprovalRequest[]
  approvalDecisions         ApprovalDecision[]
  fakeBankWebhookDeliveries FakeBankWebhookDelivery[]
}

model Membership {
  id                         String                          @id @default(uuid()) @db.Uuid
  organizationId             String                          @db.Uuid
  userId                     String                          @db.Uuid
  role                       MembershipRole
  status                     MembershipStatus                @default(ACTIVE)
  validUntil                 DateTime?                       @db.Timestamptz(3)
  createdAt                  DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                        @updatedAt @db.Timestamptz(3)
  organization               Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                       User                            @relation(fields: [userId], references: [id], onDelete: Restrict)
  buildingAccess             MembershipBuildingAccess[]
  occupancies                Occupancy[]
  auditEvents                AuditEvent[]
  bankAccountVersionsCreated VendorBankAccountVersion[]      @relation("BankAccountVersionCreator")
  bankAccountVerifications   VendorBankAccountVerification[] @relation("BankAccountVerifier")
  invoicesCreated            Invoice[]                       @relation("InvoiceCreator")
  documentsCreated           Document[]                      @relation("DocumentCreator")
  approvalRequestsInitiated  ApprovalRequest[]               @relation("ApprovalInitiator")
  approvalDecisions          ApprovalDecision[]              @relation("ApprovalDecider")

  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@index([userId, status])
  @@index([organizationId, role, status])
}

model Invitation {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  email          String         @db.VarChar(320)
  role           MembershipRole
  tokenHash      String         @unique @db.VarChar(128)
  expiresAt      DateTime       @db.Timestamptz(3)
  acceptedAt     DateTime?      @db.Timestamptz(3)
  revokedAt      DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
}

model Session {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @db.Uuid
  organizationId    String                @db.Uuid
  tokenFamilyId     String                @db.Uuid
  refreshTokenHash  String                @unique @db.VarChar(128)
  csrfTokenHash     String                @db.VarChar(128)
  userAgent         String?               @db.VarChar(512)
  ipAddress         String?               @db.Inet
  rotationCounter   Int                   @default(0)
  stepUpVerifiedAt  DateTime?             @db.Timestamptz(3)
  lastUsedAt        DateTime              @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime              @db.Timestamptz(3)
  revokedAt         DateTime?             @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens     SessionRefreshToken[]
  passkeyChallenges PasskeyChallenge[]
  approvalDecisions ApprovalDecision[]

  @@unique([id, organizationId])
  @@index([userId, revokedAt])
  @@index([organizationId, revokedAt])
  @@index([tokenFamilyId])
}

model SessionRefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @db.Uuid
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, usedAt, revokedAt])
}

model PasskeyChallenge {
  id        String                  @id @default(uuid()) @db.Uuid
  userId    String                  @db.Uuid
  sessionId String                  @db.Uuid
  purpose   PasskeyChallengePurpose
  challenge String                  @unique @db.VarChar(128)
  expiresAt DateTime                @db.Timestamptz(3)
  usedAt    DateTime?               @db.Timestamptz(3)
  createdAt DateTime                @default(now()) @db.Timestamptz(3)
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   Session                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, purpose, usedAt])
}

model WebAuthnCredential {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  credentialId String    @unique @db.VarChar(512)
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]
  deviceName   String?   @db.VarChar(120)
  backedUp     Boolean   @default(false)
  lastUsedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique @db.VarChar(128)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model Building {
  id               String                     @id @default(uuid()) @db.Uuid
  organizationId   String                     @db.Uuid
  name             String                     @db.VarChar(160)
  addressLine1     String                     @db.VarChar(200)
  addressLine2     String?                    @db.VarChar(200)
  city             String                     @db.VarChar(120)
  postalCode       String                     @db.VarChar(24)
  countryCode      String                     @db.Char(2)
  version          Int                        @default(1)
  createdAt        DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                   @updatedAt @db.Timestamptz(3)
  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apartments       Apartment[]
  membershipAccess MembershipBuildingAccess[]
  vendorLinks      VendorBuilding[]
  contractLinks    ContractBuilding[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@index([organizationId, city, name])
}

model Apartment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  buildingId     String       @db.Uuid
  unitNumber     String       @db.VarChar(40)
  floor          String?      @db.VarChar(20)
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  building       Building     @relation(fields: [buildingId, organizationId], references: [id, organizationId], onDelete: Restrict)
  occupancies    Occupancy[]

  @@unique([id, organizationId])
  @@unique([organizationId, buildingId, unitNumber])
  @@index([organizationId, unitNumber])
}

model MembershipBuildingAccess {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  membershipId   String     @db.Uuid
  buildingId     String     @db.Uuid
  validFrom      DateTime   @default(now()) @db.Timestamptz(3)
  validUntil     DateTime?  @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  membership     Membership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  building       Building   @relation(fields: [buildingId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, membershipId, buildingId])
  @@index([organizationId, buildingId, validUntil])
}

model Occupancy {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  apartmentId    String       @db.Uuid
  membershipId   String       @db.Uuid
  startsOn       DateTime     @db.Date
  endsOn         DateTime?    @db.Date
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apartment      Apartment    @relation(fields: [apartmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  membership     Membership   @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, apartmentId, startsOn])
  @@index([organizationId, membershipId, endsOn])
}

model Vendor {
  id                  String                     @id @default(uuid()) @db.Uuid
  organizationId      String                     @db.Uuid
  legalName           String                     @db.VarChar(200)
  tradingName         String?                    @db.VarChar(200)
  registrationNumber  String?                    @db.VarChar(80)
  taxId               String?                    @db.VarChar(80)
  email               String?                    @db.VarChar(320)
  phone               String?                    @db.VarChar(40)
  status              VendorStatus               @default(DRAFT)
  tags                String[]
  internalNotes       String?                    @db.VarChar(4000)
  version             Int                        @default(1)
  createdAt           DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @db.Timestamptz(3)
  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts            VendorContact[]
  buildingLinks       VendorBuilding[]
  bankAccountVersions VendorBankAccountVersion[]
  contracts           Contract[]
  invoices            Invoice[]

  @@unique([id, organizationId])
  @@index([organizationId, status, legalName])
  @@index([organizationId, registrationNumber])
}

model VendorContact {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  vendorId       String    @db.Uuid
  name           String    @db.VarChar(160)
  role           String?   @db.VarChar(120)
  email          String?   @db.VarChar(320)
  phone          String?   @db.VarChar(40)
  isVerified     Boolean   @default(false)
  verifiedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  vendor         Vendor    @relation(fields: [vendorId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, vendorId, isVerified])
}

model VendorBuilding {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  vendorId       String   @db.Uuid
  buildingId     String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  vendor         Vendor   @relation(fields: [vendorId, organizationId], references: [id, organizationId], onDelete: Cascade)
  building       Building @relation(fields: [buildingId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, vendorId, buildingId])
  @@index([organizationId, buildingId])
}

model VendorBankAccountVersion {
  id                        String                          @id @default(uuid()) @db.Uuid
  organizationId            String                          @db.Uuid
  vendorId                  String                          @db.Uuid
  versionNumber             Int
  countryCode               String                          @db.Char(2)
  encryptedAccount          String                          @db.Text
  encryptionIv              String                          @db.VarChar(64)
  encryptionTag             String                          @db.VarChar(64)
  encryptionKeyId           String                          @db.VarChar(80)
  accountFingerprint        String                          @db.VarChar(128)
  maskedAccount             String                          @db.VarChar(80)
  maskedAccountHolder       String                          @db.VarChar(200)
  createdByMembershipId     String                          @db.Uuid
  createdAt                 DateTime                        @default(now()) @db.Timestamptz(3)
  externalStatus            BankAccountVerificationStatus   @default(PENDING)
  externalStatusUpdatedAt   DateTime?                       @db.Timestamptz(3)
  vendor                    Vendor                          @relation(fields: [vendorId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdByMembership       Membership                      @relation("BankAccountVersionCreator", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  verifications             VendorBankAccountVerification[]
  invoices                  Invoice[]                       @relation("InvoiceBankAccountVersion")
  approvalRequests          ApprovalRequest[]
  fakeBankWebhookDeliveries FakeBankWebhookDelivery[]

  @@unique([id, organizationId])
  @@unique([organizationId, vendorId, versionNumber])
  @@index([organizationId, vendorId, createdAt])
  @@index([organizationId, accountFingerprint])
}

model VendorBankAccountVerification {
  id                     String                        @id @default(uuid()) @db.Uuid
  organizationId         String                        @db.Uuid
  bankAccountVersionId   String                        @db.Uuid
  status                 BankAccountVerificationStatus
  evidenceReference      String?                       @db.VarChar(500)
  reason                 String?                       @db.VarChar(500)
  verifiedByMembershipId String                        @db.Uuid
  createdAt              DateTime                      @default(now()) @db.Timestamptz(3)
  bankAccountVersion     VendorBankAccountVersion      @relation(fields: [bankAccountVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  verifiedByMembership   Membership                    @relation("BankAccountVerifier", fields: [verifiedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, bankAccountVersionId, createdAt])
}

model Contract {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @db.Uuid
  vendorId          String             @db.Uuid
  reference         String             @db.VarChar(80)
  title             String             @db.VarChar(200)
  serviceCategory   String             @db.VarChar(120)
  valueLimit        Decimal?           @db.Decimal(19, 2)
  currency          String?            @db.Char(3)
  startsOn          DateTime           @db.Date
  endsOn            DateTime?          @db.Date
  status            ContractStatus     @default(DRAFT)
  documentReference String?            @db.VarChar(500)
  version           Int                @default(1)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor            Vendor             @relation(fields: [vendorId, organizationId], references: [id, organizationId], onDelete: Restrict)
  buildingLinks     ContractBuilding[]
  invoices          Invoice[]

  @@unique([id, organizationId])
  @@unique([organizationId, reference])
  @@index([organizationId, status, endsOn])
  @@index([organizationId, vendorId])
}

model ContractBuilding {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  contractId     String   @db.Uuid
  buildingId     String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  contract       Contract @relation(fields: [contractId, organizationId], references: [id, organizationId], onDelete: Cascade)
  building       Building @relation(fields: [buildingId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, contractId, buildingId])
  @@index([organizationId, buildingId])
}

model Invoice {
  id                         String                    @id @default(uuid()) @db.Uuid
  organizationId             String                    @db.Uuid
  vendorId                   String?                   @db.Uuid
  contractId                 String?                   @db.Uuid
  vendorBankAccountVersionId String?                   @db.Uuid
  invoiceNumber              String?                   @db.VarChar(80)
  issueDate                  DateTime?                 @db.Date
  dueDate                    DateTime?                 @db.Date
  currency                   String?                   @db.Char(3)
  subtotal                   Decimal?                  @db.Decimal(19, 2)
  taxAmount                  Decimal?                  @db.Decimal(19, 2)
  totalAmount                Decimal?                  @db.Decimal(19, 2)
  notes                      String?                   @db.VarChar(4000)
  status                     InvoiceStatus             @default(PROCESSING)
  version                    Int                       @default(1)
  createdByMembershipId      String                    @db.Uuid
  createdAt                  DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                  @updatedAt @db.Timestamptz(3)
  organization               Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor                     Vendor?                   @relation(fields: [vendorId, organizationId], references: [id, organizationId], onDelete: Restrict)
  contract                   Contract?                 @relation(fields: [contractId, organizationId], references: [id, organizationId], onDelete: Restrict)
  vendorBankAccountVersion   VendorBankAccountVersion? @relation("InvoiceBankAccountVersion", fields: [vendorBankAccountVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdByMembership        Membership                @relation("InvoiceCreator", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  lines                      InvoiceLine[]
  documents                  Document[]
  riskAssessments            RiskAssessment[]
  approvalRequests           ApprovalRequest[]

  @@unique([id, organizationId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, vendorId, invoiceNumber])
  @@index([organizationId, contractId])
  @@index([organizationId, vendorBankAccountVersionId])
}

model InvoiceLine {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  invoiceId      String   @db.Uuid
  description    String   @db.VarChar(500)
  quantity       Decimal  @db.Decimal(19, 4)
  unitPrice      Decimal  @db.Decimal(19, 4)
  taxRate        Decimal? @db.Decimal(7, 4)
  amount         Decimal  @db.Decimal(19, 2)
  position       Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  invoice        Invoice  @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, invoiceId, position])
  @@index([organizationId, invoiceId])
}

model Document {
  id                    String               @id @default(uuid()) @db.Uuid
  organizationId        String               @db.Uuid
  invoiceId             String               @db.Uuid
  kind                  DocumentKind         @default(INVOICE_SOURCE)
  originalFilename      String               @db.VarChar(255)
  declaredMimeType      String               @db.VarChar(120)
  detectedMimeType      String               @db.VarChar(120)
  sizeBytes             BigInt
  quarantineObjectKey   String               @unique @db.VarChar(512)
  approvedObjectKey     String?              @unique @db.VarChar(512)
  sha256                String?              @db.Char(64)
  duplicateOfDocumentId String?              @db.Uuid
  storageState          DocumentStorageState @default(QUARANTINED)
  createdByMembershipId String               @db.Uuid
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(3)
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice               Invoice              @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdByMembership   Membership           @relation("DocumentCreator", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  duplicateOf           Document?            @relation("DocumentDuplicates", fields: [duplicateOfDocumentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  duplicates            Document[]           @relation("DocumentDuplicates")
  processing            DocumentProcessing?

  @@unique([id, organizationId])
  @@index([organizationId, invoiceId])
  @@index([organizationId, sha256])
  @@index([organizationId, duplicateOfDocumentId])
}

model DocumentProcessing {
  id              String                  @id @default(uuid()) @db.Uuid
  organizationId  String                  @db.Uuid
  documentId      String                  @db.Uuid
  state           DocumentProcessingState @default(QUARANTINED)
  progress        Int                     @default(10)
  scanResult      DocumentScanResult      @default(PENDING)
  scanDetail      String?                 @db.VarChar(500)
  ocrEngine       String?                 @db.VarChar(80)
  suggestions     Json?
  attempts        Int                     @default(0)
  lastHeartbeatAt DateTime?               @db.Timestamptz(3)
  startedAt       DateTime?               @db.Timestamptz(3)
  completedAt     DateTime?               @db.Timestamptz(3)
  errorCode       String?                 @db.VarChar(80)
  errorMessage    String?                 @db.VarChar(500)
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(3)
  document        Document                @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([documentId, organizationId])
  @@index([organizationId, state, updatedAt])
}

model OrganizationRiskPolicy {
  id                          String       @id @default(uuid()) @db.Uuid
  organizationId              String       @unique @db.Uuid
  ruleVersion                 Int          @default(1)
  mediumThreshold             Int          @default(30)
  highThreshold               Int          @default(70)
  changedBankAccountScore     Int          @default(70)
  duplicateHashScore          Int          @default(70)
  duplicateInvoiceNumberScore Int          @default(35)
  contractLimitScore          Int          @default(50)
  amountSpikeScore            Int          @default(25)
  requireSeparationOfDuties   Boolean      @default(true)
  createdAt                   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime     @updatedAt @db.Timestamptz(3)
  organization                Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model RiskAssessment {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  invoiceId       String           @db.Uuid
  invoiceVersion  Int
  ruleVersion     Int
  facts           Json
  contributions   Json
  totalScore      Int
  level           RiskLevel
  evidenceHash    String           @db.Char(64)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice         Invoice          @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  approvalRequest ApprovalRequest?

  @@unique([id, organizationId])
  @@unique([organizationId, invoiceId, invoiceVersion])
  @@index([organizationId, level, createdAt])
}

model ApprovalRequest {
  id                         String                    @id @default(uuid()) @db.Uuid
  organizationId             String                    @db.Uuid
  invoiceId                  String                    @db.Uuid
  invoiceVersion             Int
  riskAssessmentId           String                    @unique @db.Uuid
  vendorBankAccountVersionId String?                   @db.Uuid
  version                    Int
  status                     ApprovalRequestStatus     @default(PENDING)
  requiredDecisions          Int
  initiatedByMembershipId    String                    @db.Uuid
  idempotencyKeyHash         String                    @db.Char(64)
  invalidatedReason          String?                   @db.VarChar(500)
  completedAt                DateTime?                 @db.Timestamptz(3)
  createdAt                  DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                  @updatedAt @db.Timestamptz(3)
  organization               Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice                    Invoice                   @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  riskAssessment             RiskAssessment            @relation(fields: [riskAssessmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  vendorBankAccountVersion   VendorBankAccountVersion? @relation(fields: [vendorBankAccountVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  initiatedByMembership      Membership                @relation("ApprovalInitiator", fields: [initiatedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  decisions                  ApprovalDecision[]

  @@unique([id, organizationId])
  @@unique([organizationId, invoiceId, version])
  @@unique([organizationId, idempotencyKeyHash])
  @@unique([riskAssessmentId, organizationId])
  @@index([organizationId, status, createdAt])
}

model ApprovalDecision {
  id                    String                  @id @default(uuid()) @db.Uuid
  organizationId        String                  @db.Uuid
  approvalRequestId     String                  @db.Uuid
  approvalVersion       Int
  decidedByMembershipId String                  @db.Uuid
  sessionId             String                  @db.Uuid
  outcome               ApprovalDecisionOutcome
  reason                String                  @db.VarChar(500)
  stepUpVerifiedAt      DateTime                @db.Timestamptz(3)
  idempotencyKeyHash    String                  @db.Char(64)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvalRequest       ApprovalRequest         @relation(fields: [approvalRequestId, organizationId], references: [id, organizationId], onDelete: Restrict)
  decidedByMembership   Membership              @relation("ApprovalDecider", fields: [decidedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  session               Session                 @relation(fields: [sessionId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, approvalRequestId, decidedByMembershipId])
  @@unique([organizationId, idempotencyKeyHash])
  @@index([organizationId, approvalRequestId, createdAt])
}

model FakeBankWebhookDelivery {
  id                   String                        @id @default(uuid()) @db.Uuid
  organizationId       String                        @db.Uuid
  eventId              String                        @db.Uuid
  vendorId             String                        @db.Uuid
  bankAccountVersionId String                        @db.Uuid
  status               BankAccountVerificationStatus
  payloadHash          String                        @db.Char(64)
  providerTimestamp    DateTime                      @db.Timestamptz(3)
  processedAt          DateTime                      @default(now()) @db.Timestamptz(3)
  organization         Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccountVersion   VendorBankAccountVersion      @relation(fields: [bankAccountVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, eventId])
  @@index([organizationId, bankAccountVersionId, processedAt])
}

model AuditEvent {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @db.Uuid
  actorMembershipId String?      @db.Uuid
  action            String       @db.VarChar(120)
  entityType        String       @db.VarChar(80)
  entityId          String       @db.Uuid
  before            Json?
  after             Json?
  reason            String?      @db.VarChar(500)
  correlationId     String       @db.Uuid
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorMembership   Membership?  @relation(fields: [actorMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId, createdAt])
}
