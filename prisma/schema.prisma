generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipRole {
  OWNER
  ADMINISTRATOR
  ACCOUNTANT
  RESIDENT
  CONTRACTOR
  AUDITOR
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  ENDED
}

enum PasskeyChallengePurpose {
  REGISTRATION
  STEP_UP
}

enum VendorStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum BankAccountVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique @db.VarChar(320)
  displayName         String               @db.VarChar(120)
  passwordHash        String?              @db.VarChar(512)
  status              UserStatus           @default(ACTIVE)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  memberships         Membership[]
  sessions            Session[]
  webAuthnCredentials WebAuthnCredential[]
  recoveryCodes       RecoveryCode[]
  passkeyChallenges   PasskeyChallenge[]
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique @db.VarChar(80)
  name        String       @db.VarChar(160)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  memberships Membership[]
  invitations Invitation[]
  sessions    Session[]
  buildings   Building[]
  apartments  Apartment[]
  occupancies Occupancy[]
  vendors     Vendor[]
  contracts   Contract[]
  auditEvents AuditEvent[]
}

model Membership {
  id                         String                          @id @default(uuid()) @db.Uuid
  organizationId             String                          @db.Uuid
  userId                     String                          @db.Uuid
  role                       MembershipRole
  status                     MembershipStatus                @default(ACTIVE)
  validUntil                 DateTime?                       @db.Timestamptz(3)
  createdAt                  DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                        @updatedAt @db.Timestamptz(3)
  organization               Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                       User                            @relation(fields: [userId], references: [id], onDelete: Restrict)
  buildingAccess             MembershipBuildingAccess[]
  occupancies                Occupancy[]
  auditEvents                AuditEvent[]
  bankAccountVersionsCreated VendorBankAccountVersion[]      @relation("BankAccountVersionCreator")
  bankAccountVerifications   VendorBankAccountVerification[] @relation("BankAccountVerifier")

  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@index([userId, status])
  @@index([organizationId, role, status])
}

model Invitation {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  email          String         @db.VarChar(320)
  role           MembershipRole
  tokenHash      String         @unique @db.VarChar(128)
  expiresAt      DateTime       @db.Timestamptz(3)
  acceptedAt     DateTime?      @db.Timestamptz(3)
  revokedAt      DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
}

model Session {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @db.Uuid
  organizationId    String                @db.Uuid
  tokenFamilyId     String                @db.Uuid
  refreshTokenHash  String                @unique @db.VarChar(128)
  csrfTokenHash     String                @db.VarChar(128)
  userAgent         String?               @db.VarChar(512)
  ipAddress         String?               @db.Inet
  rotationCounter   Int                   @default(0)
  stepUpVerifiedAt  DateTime?             @db.Timestamptz(3)
  lastUsedAt        DateTime              @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime              @db.Timestamptz(3)
  revokedAt         DateTime?             @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens     SessionRefreshToken[]
  passkeyChallenges PasskeyChallenge[]

  @@index([userId, revokedAt])
  @@index([organizationId, revokedAt])
  @@index([tokenFamilyId])
}

model SessionRefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @db.Uuid
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, usedAt, revokedAt])
}

model PasskeyChallenge {
  id        String                  @id @default(uuid()) @db.Uuid
  userId    String                  @db.Uuid
  sessionId String                  @db.Uuid
  purpose   PasskeyChallengePurpose
  challenge String                  @unique @db.VarChar(128)
  expiresAt DateTime                @db.Timestamptz(3)
  usedAt    DateTime?               @db.Timestamptz(3)
  createdAt DateTime                @default(now()) @db.Timestamptz(3)
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   Session                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, purpose, usedAt])
}

model WebAuthnCredential {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  credentialId String    @unique @db.VarChar(512)
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]
  deviceName   String?   @db.VarChar(120)
  backedUp     Boolean   @default(false)
  lastUsedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique @db.VarChar(128)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model Building {
  id               String                     @id @default(uuid()) @db.Uuid
  organizationId   String                     @db.Uuid
  name             String                     @db.VarChar(160)
  addressLine1     String                     @db.VarChar(200)
  addressLine2     String?                    @db.VarChar(200)
  city             String                     @db.VarChar(120)
  postalCode       String                     @db.VarChar(24)
  countryCode      String                     @db.Char(2)
  version          Int                        @default(1)
  createdAt        DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                   @updatedAt @db.Timestamptz(3)
  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apartments       Apartment[]
  membershipAccess MembershipBuildingAccess[]
  vendorLinks      VendorBuilding[]
  contractLinks    ContractBuilding[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@index([organizationId, city, name])
}

model Apartment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  buildingId     String       @db.Uuid
  unitNumber     String       @db.VarChar(40)
  floor          String?      @db.VarChar(20)
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  building       Building     @relation(fields: [buildingId, organizationId], references: [id, organizationId], onDelete: Restrict)
  occupancies    Occupancy[]

  @@unique([id, organizationId])
  @@unique([organizationId, buildingId, unitNumber])
  @@index([organizationId, unitNumber])
}

model MembershipBuildingAccess {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  membershipId   String     @db.Uuid
  buildingId     String     @db.Uuid
  validFrom      DateTime   @default(now()) @db.Timestamptz(3)
  validUntil     DateTime?  @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  membership     Membership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  building       Building   @relation(fields: [buildingId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, membershipId, buildingId])
  @@index([organizationId, buildingId, validUntil])
}

model Occupancy {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  apartmentId    String       @db.Uuid
  membershipId   String       @db.Uuid
  startsOn       DateTime     @db.Date
  endsOn         DateTime?    @db.Date
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apartment      Apartment    @relation(fields: [apartmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  membership     Membership   @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, apartmentId, startsOn])
  @@index([organizationId, membershipId, endsOn])
}

model Vendor {
  id                  String                     @id @default(uuid()) @db.Uuid
  organizationId      String                     @db.Uuid
  legalName           String                     @db.VarChar(200)
  tradingName         String?                    @db.VarChar(200)
  registrationNumber  String?                    @db.VarChar(80)
  taxId               String?                    @db.VarChar(80)
  email               String?                    @db.VarChar(320)
  phone               String?                    @db.VarChar(40)
  status              VendorStatus               @default(DRAFT)
  tags                String[]
  internalNotes       String?                    @db.VarChar(4000)
  version             Int                        @default(1)
  createdAt           DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @db.Timestamptz(3)
  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts            VendorContact[]
  buildingLinks       VendorBuilding[]
  bankAccountVersions VendorBankAccountVersion[]
  contracts           Contract[]

  @@unique([id, organizationId])
  @@index([organizationId, status, legalName])
  @@index([organizationId, registrationNumber])
}

model VendorContact {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  vendorId       String    @db.Uuid
  name           String    @db.VarChar(160)
  role           String?   @db.VarChar(120)
  email          String?   @db.VarChar(320)
  phone          String?   @db.VarChar(40)
  isVerified     Boolean   @default(false)
  verifiedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  vendor         Vendor    @relation(fields: [vendorId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, vendorId, isVerified])
}

model VendorBuilding {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  vendorId       String   @db.Uuid
  buildingId     String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  vendor         Vendor   @relation(fields: [vendorId, organizationId], references: [id, organizationId], onDelete: Cascade)
  building       Building @relation(fields: [buildingId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, vendorId, buildingId])
  @@index([organizationId, buildingId])
}

model VendorBankAccountVersion {
  id                    String                          @id @default(uuid()) @db.Uuid
  organizationId        String                          @db.Uuid
  vendorId              String                          @db.Uuid
  versionNumber         Int
  countryCode           String                          @db.Char(2)
  encryptedAccount      String                          @db.Text
  encryptionIv          String                          @db.VarChar(64)
  encryptionTag         String                          @db.VarChar(64)
  encryptionKeyId       String                          @db.VarChar(80)
  accountFingerprint    String                          @db.VarChar(128)
  maskedAccount         String                          @db.VarChar(80)
  maskedAccountHolder   String                          @db.VarChar(200)
  createdByMembershipId String                          @db.Uuid
  createdAt             DateTime                        @default(now()) @db.Timestamptz(3)
  vendor                Vendor                          @relation(fields: [vendorId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdByMembership   Membership                      @relation("BankAccountVersionCreator", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  verifications         VendorBankAccountVerification[]

  @@unique([id, organizationId])
  @@unique([organizationId, vendorId, versionNumber])
  @@index([organizationId, vendorId, createdAt])
  @@index([organizationId, accountFingerprint])
}

model VendorBankAccountVerification {
  id                     String                        @id @default(uuid()) @db.Uuid
  organizationId         String                        @db.Uuid
  bankAccountVersionId   String                        @db.Uuid
  status                 BankAccountVerificationStatus
  evidenceReference      String?                       @db.VarChar(500)
  reason                 String?                       @db.VarChar(500)
  verifiedByMembershipId String                        @db.Uuid
  createdAt              DateTime                      @default(now()) @db.Timestamptz(3)
  bankAccountVersion     VendorBankAccountVersion      @relation(fields: [bankAccountVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  verifiedByMembership   Membership                    @relation("BankAccountVerifier", fields: [verifiedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, bankAccountVersionId, createdAt])
}

model Contract {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @db.Uuid
  vendorId          String             @db.Uuid
  reference         String             @db.VarChar(80)
  title             String             @db.VarChar(200)
  serviceCategory   String             @db.VarChar(120)
  valueLimit        Decimal?           @db.Decimal(19, 2)
  currency          String?            @db.Char(3)
  startsOn          DateTime           @db.Date
  endsOn            DateTime?          @db.Date
  status            ContractStatus     @default(DRAFT)
  documentReference String?            @db.VarChar(500)
  version           Int                @default(1)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor            Vendor             @relation(fields: [vendorId, organizationId], references: [id, organizationId], onDelete: Restrict)
  buildingLinks     ContractBuilding[]

  @@unique([id, organizationId])
  @@unique([organizationId, reference])
  @@index([organizationId, status, endsOn])
  @@index([organizationId, vendorId])
}

model ContractBuilding {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  contractId     String   @db.Uuid
  buildingId     String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  contract       Contract @relation(fields: [contractId, organizationId], references: [id, organizationId], onDelete: Cascade)
  building       Building @relation(fields: [buildingId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, contractId, buildingId])
  @@index([organizationId, buildingId])
}

model AuditEvent {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @db.Uuid
  actorMembershipId String?      @db.Uuid
  action            String       @db.VarChar(120)
  entityType        String       @db.VarChar(80)
  entityId          String       @db.Uuid
  before            Json?
  after             Json?
  reason            String?      @db.VarChar(500)
  correlationId     String       @db.Uuid
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorMembership   Membership?  @relation(fields: [actorMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId, createdAt])
}
